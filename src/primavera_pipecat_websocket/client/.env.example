# WebSocket Server URL
# Replace with your server's IP address and port
# Examples:
#   Local: ws://localhost:8765/ws
#   LAN: ws://192.168.1.100:8765/ws
#   Remote: ws://your-server.com:8765/ws
SERVER_URL=ws://localhost:8765/ws

# Audio Device Configuration
# Run this to list devices: python -c "import pyaudio; p = pyaudio.PyAudio(); [print(f'{i}: {p.get_device_info_by_index(i)[\"name\"]}') for i in range(p.get_device_count())]"
# Use -1 for system default
AUDIO_INPUT_DEVICE=-1   # Microphone device index
AUDIO_OUTPUT_DEVICE=-1  # Speaker device index (typically 3.5mm jack on Pi)
