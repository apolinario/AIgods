# Server Configuration
HOST=0.0.0.0
PORT=8765

# Google API Key (for Gemini LLM with caching)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Local Whisper Configuration
# Model options: tiny, base, small, medium, large
# base is recommended for good balance of speed and accuracy
WHISPER_MODEL=base

# VibeVoice TTS Configuration
# Base URL for your VibeVoice server
VIBEVOICE_BASE_URL=http://localhost:8000

# Model name for VibeVoice
VIBEVOICE_MODEL=your_model_name

# Path to the voice file on the VibeVoice server
VIBEVOICE_PATH=/path/to/voice/file.wav

# Optional: Use local Whisper instead of OpenAI
# Uncomment and set to true to use local Whisper (requires more RAM/CPU)
# USE_LOCAL_WHISPER=false
# WHISPER_MODEL=base  # Options: tiny, base, small, medium, large
